{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/scans/{id}/assets": {
            "get": {
                "description": "Retrive assets from the OS and Services based on the ScanID KPTM Tools - Core Service",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scans"
                ],
                "summary": "GetScanAssetsByID",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ScanAssetsResponse"
                        }
                    },
                    "404": {
                        "description": "Scan not found",
                        "schema": {
                            "$ref": "#/definitions/api.APIError"
                        }
                    },
                    "409": {
                        "description": "Scan status not completed",
                        "schema": {
                            "$ref": "#/definitions/api.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/api.APIError"
                        }
                    }
                }
            }
        },
        "/healthcheck": {
            "get": {
                "description": "Check status of the KPTM Tools - Core Service",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System Status"
                ],
                "summary": "HealthCheck",
                "responses": {
                    "200": {
                        "description": "Healthcheck - OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
